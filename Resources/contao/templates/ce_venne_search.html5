<?php
/**
 * Frontend-Template: zwei Modes — `inline` (Suchfeld direkt im Layout) und
 * `modal` (Trigger-Button öffnet Overlay-Suche).
 *
 * @var \Contao\FrontendTemplate $this
 */
$isModal = ($this->displayMode ?? 'inline') === 'modal';

// i18n-Map fuer alle UI-Strings im JS — basierend auf Page-Locale.
// User-Werte aus dem Modul-Setting koennen nicht alle Strings ueberschreiben,
// deshalb hier eine Default-Tabelle pro Sprache; Fallback ist Englisch.
$vsLocale = strtolower(substr((string) $this->locale, 0, 2));
$vsI18nMap = [
    'de' => [
        'close' => 'Schließen',
        'filter' => 'Filter',
        'loading' => 'Lädt …',
        'loadMore' => 'Mehr laden ({n} weitere)',
        'hits' => '{n} Treffer · {ms} ms',
        'noResults' => 'Keine Treffer für „{q}"',
        'noResultsHint' => 'Versuche ein anderes Wort, prüfe die Schreibweise oder kürze den Suchbegriff.',
        'recent' => 'Zuletzt gesucht',
        'popularTags' => 'Beliebte Tags',
        'whatLookingFor' => 'Was suchst du?',
        'initialHint' => 'Tippe ein Suchwort ein — Treffer erscheinen sofort.',
        'searchError' => 'Fehler bei der Suche',
        'searchErrorHint' => 'Bitte versuche es erneut.',
        'contentType' => 'Inhaltsart',
        'fileType' => 'Dateityp',
        'tags' => 'Tags',
        'all' => 'Alle',
        'sortRelevance' => 'Relevanz',
        'sortNewest' => 'Neueste',
        'sortOldest' => 'Älteste',
        'sortType' => 'Art',
        'typePage' => 'Seite',  'typeFile' => 'Datei', 'typeArticle' => 'Artikel', 'typeCrawled' => 'Webseite',
        'typePages' => 'Seiten', 'typeFiles' => 'Dateien', 'typeArticles' => 'Artikel', 'typeCrawledPl' => 'Websiteinhalte',
        'lockedTitle' => 'Nur für Mitglieder sichtbar',
        'lockedAria' => 'Geschützter Inhalt',
    ],
    'en' => [
        'close' => 'Close',
        'filter' => 'Filter',
        'loading' => 'Loading …',
        'loadMore' => 'Load more ({n} remaining)',
        'hits' => '{n} results · {ms} ms',
        'noResults' => 'No results for „{q}"',
        'noResultsHint' => 'Try a different word, check spelling or shorten the term.',
        'recent' => 'Recent searches',
        'popularTags' => 'Popular tags',
        'whatLookingFor' => 'What are you looking for?',
        'initialHint' => 'Type a keyword — results appear instantly.',
        'searchError' => 'Search error',
        'searchErrorHint' => 'Please try again.',
        'contentType' => 'Content type',
        'fileType' => 'File type',
        'tags' => 'Tags',
        'all' => 'All',
        'sortRelevance' => 'Relevance',
        'sortNewest' => 'Newest',
        'sortOldest' => 'Oldest',
        'sortType' => 'Type',
        'typePage' => 'Page',  'typeFile' => 'File', 'typeArticle' => 'Article', 'typeCrawled' => 'Web page',
        'typePages' => 'Pages', 'typeFiles' => 'Files', 'typeArticles' => 'Articles', 'typeCrawledPl' => 'Web content',
        'lockedTitle' => 'Members only',
        'lockedAria' => 'Protected content',
    ],
];
$vsI18n = $vsI18nMap[$vsLocale] ?? $vsI18nMap['en'];
?>
<!-- venne-search-bundle template v2.2.0-dev — Wenn du ein anderes Layout siehst, ist das Bundle nicht aktuell. Update: composer require venne-media/venne-search-contao-bundle:^2.2 -->
<div class="vsearch mod_venne_search vsearch--<?= $isModal ? 'modal' : 'inline' ?><?= $this->cssID && $this->cssID[1] ? ' '.$this->cssID[1] : '' ?>"<?= $this->cssID && $this->cssID[0] ? ' id="'.$this->cssID[0].'"' : '' ?>
     data-vsearch
     data-vsearch-version="2.2.0-dev"
     data-mode="<?= $isModal ? 'modal' : 'inline' ?>"
     data-api-url="<?= $this->apiUrl ?>"
     data-locale="<?= $this->locale ?>"
     data-min-chars="<?= $this->minChars ?>"
     data-limit="<?= $this->limit ?>"
     data-module-id="<?= $this->moduleId ?>"
     data-show-sort="<?= $this->showSort ? '1' : '0' ?>"
     data-show-filetype-filter="<?= $this->showFiletypeFilter ? '1' : '0' ?>"
     data-open-new-tab="<?= $this->openInNewTab ? '1' : '0' ?>"
     data-i18n="<?= htmlspecialchars(json_encode($vsI18n, JSON_UNESCAPED_UNICODE), ENT_QUOTES) ?>">

    <?php if ($isModal): ?>
        <button type="button" class="vsearch__trigger" data-vsearch-trigger>
            <svg class="vsearch__trigger-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <span class="vsearch__trigger-label"><?= htmlspecialchars((string) $this->triggerLabel) ?></span>
        </button>
    <?php endif; ?>

    <div class="vsearch__shell<?= $isModal ? ' vsearch__shell--modal' : '' ?>"<?= $isModal ? ' data-vsearch-shell hidden' : '' ?>>
        <div class="vsearch__panel">
            <?php if ($isModal): ?>
                <button type="button" class="vsearch__close" data-vsearch-close aria-label="<?= htmlspecialchars($vsI18n['close'], ENT_QUOTES) ?>"></button>
            <?php endif; ?>

            <?php if ($this->headline && !$isModal): ?>
                <<?= $this->hl ?: 'h2' ?> class="vsearch__headline"><?= $this->headline ?></<?= $this->hl ?: 'h2' ?>>
            <?php endif; ?>

            <form class="vsearch__form" role="search" autocomplete="off" onsubmit="return false;">
                <div class="vsearch__inputwrap">
                    <svg class="vsearch__inputicon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="11" cy="11" r="7"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <label class="vsearch__sr" for="vsearch-input-<?= $this->moduleId ?>"><?= htmlspecialchars($vsI18n['sortRelevance'] === 'Relevance' ? 'Search' : 'Suche') ?></label>
                    <input
                        id="vsearch-input-<?= $this->moduleId ?>"
                        class="vsearch__input"
                        type="search"
                        name="q"
                        placeholder="<?= htmlspecialchars((string) $this->placeholder, ENT_QUOTES) ?>"
                        autocomplete="off"
                        spellcheck="false"
                        data-vsearch-input
                    >
                    <button type="button" class="vsearch__clear" data-vsearch-clear hidden aria-label="<?= htmlspecialchars($vsI18n['close'], ENT_QUOTES) ?>">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                            <line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/>
                        </svg>
                    </button>
                </div>
            </form>

            <div class="vsearch__toolbar" data-vsearch-toolbar hidden>
                <div class="vsearch__toolbar-row">
                    <p class="vsearch__meta" data-vsearch-meta></p>
                    <?php if ($this->showFacets): ?>
                        <button type="button" class="vsearch__filter-toggle" data-vsearch-filter-toggle aria-label="<?= htmlspecialchars($vsI18n['filter'], ENT_QUOTES) ?>">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="3" y1="6" x2="21" y2="6"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="10" y1="18" x2="14" y2="18"/>
                            </svg>
                            <?= htmlspecialchars($vsI18n['filter']) ?>
                        </button>
                    <?php endif; ?>
                    <?php /* Sort-Pills immer rendern — User muss zwischen Relevanz/Neueste/Aelteste umschalten koennen. Backend-Setting wird ignoriert. */ ?>
                    <div class="vsearch__sort-pills" role="tablist" aria-label="<?= htmlspecialchars($vsI18n['sortRelevance'], ENT_QUOTES) ?>" data-vsearch-sort-pills>
                        <button type="button" class="vsearch__sort-pill vsearch__sort-pill--active" data-sort="relevance" aria-pressed="true">
                            <svg class="vsearch__sort-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l2.39 7.36H22l-6.19 4.5 2.39 7.36L12 16.72l-6.19 4.5 2.39-7.36L2 9.36h7.61L12 2z"/></svg>
                            <span><?= htmlspecialchars($vsI18n['sortRelevance']) ?></span>
                        </button>
                        <button type="button" class="vsearch__sort-pill" data-sort="date_desc" aria-pressed="false">
                            <svg class="vsearch__sort-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4v16M7 20l-4-4M7 20l4-4M14 6h7M14 12h5M14 18h3"/></svg>
                            <span><?= htmlspecialchars($vsI18n['sortNewest']) ?></span>
                        </button>
                        <button type="button" class="vsearch__sort-pill" data-sort="date_asc" aria-pressed="false">
                            <svg class="vsearch__sort-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20V4M7 4l-4 4M7 4l4 4M14 6h3M14 12h5M14 18h7"/></svg>
                            <span><?= htmlspecialchars($vsI18n['sortOldest']) ?></span>
                        </button>
                        <button type="button" class="vsearch__sort-pill" data-sort="type_asc" aria-pressed="false">
                            <svg class="vsearch__sort-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                            <span><?= htmlspecialchars($vsI18n['sortType']) ?></span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="vsearch__body" data-vsearch-body hidden>
                <?php if ($this->showFacets): ?>
                    <aside class="vsearch__sidebar" data-vsearch-sidebar>
                        <div class="vsearch__sidebar-section" data-vsearch-sidebar-types>
                            <h3 class="vsearch__sidebar-title"><?= htmlspecialchars($vsI18n['contentType']) ?></h3>
                            <div class="vsearch__facets" data-vsearch-facets></div>
                        </div>
                        <?php if ($this->showFiletypeFilter): ?>
                            <div class="vsearch__sidebar-section" data-vsearch-sidebar-ext>
                                <h3 class="vsearch__sidebar-title"><?= htmlspecialchars($vsI18n['fileType']) ?></h3>
                                <div class="vsearch__ext-filters" data-vsearch-ext-filters hidden></div>
                            </div>
                        <?php endif; ?>
                        <div class="vsearch__sidebar-section" data-vsearch-sidebar-tags hidden>
                            <h3 class="vsearch__sidebar-title"><?= htmlspecialchars($vsI18n['tags']) ?></h3>
                            <div class="vsearch__tag-cloud" data-vsearch-tag-cloud></div>
                        </div>
                    </aside>
                <?php endif; ?>

                <div class="vsearch__main">
                    <div class="vsearch__results" data-vsearch-results hidden>
                        <ul class="vsearch__list" data-vsearch-list></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .vsearch {
        max-width: 880px;
        --vs-accent: #4a8087; --vs-accent-soft: rgba(74,128,135,.08); --vs-accent-strong: #2f6068;
        --vs-text: #1f2937; --vs-text-muted: #6b7280; --vs-text-soft: #9ca3af;
        --vs-border: rgba(0,0,0,.08); --vs-border-strong: rgba(0,0,0,.16);
        --vs-bg: #ffffff; --vs-bg-soft: #f9fafb;
        --vs-mark: #ffe27a;
        --vs-shadow-card: 0 1px 2px rgba(0,0,0,.04);
        --vs-shadow-card-hover: 0 8px 24px -10px rgba(74,128,135,.35), 0 2px 6px rgba(0,0,0,.06);
        --vs-radius: 12px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    .vsearch *, .vsearch *::before, .vsearch *::after { box-sizing: border-box; }
    .vsearch--modal { max-width: none; display: inline-block; }
    .vsearch__sr { position: absolute; left: -9999px; }
    .vsearch__headline { font-size: 1.4rem; margin: 0 0 .8rem; color: var(--vs-text); }

    /* Trigger (Modal) */
    .vsearch__trigger {
        display: inline-flex; align-items: center; gap: .5rem;
        padding: .65rem 1rem; border: 1px solid var(--vs-border-strong);
        background: var(--vs-bg); color: var(--vs-text); border-radius: 8px;
        cursor: pointer; font-size: .95rem; font-weight: 500;
        transition: border-color .15s, background .15s, color .15s;
    }
    .vsearch__trigger:hover { border-color: var(--vs-accent); background: var(--vs-accent-soft); color: var(--vs-accent); }
    .vsearch__trigger-icon { color: var(--vs-accent); flex-shrink: 0; }

    /* Modal-Shell — Profi-Layout: breit, zweispaltig wenn Treffer da */
    .vsearch__shell--modal {
        position: fixed; inset: 0; z-index: 9999;
        background: rgba(15, 23, 42, .6);
        backdrop-filter: blur(6px);
        display: flex; align-items: flex-start; justify-content: center;
        padding: 4vh 1rem 2rem;
        animation: vsearch-fade-in .2s ease-out;
        overflow-y: auto;
    }
    .vsearch__shell--modal[hidden] { display: none; }
    .vsearch__shell--modal .vsearch__panel {
        max-width: 1320px; width: 100%; background: var(--vs-bg); border-radius: 6px;
        box-shadow: 0 32px 80px -16px rgba(0,0,0,.45), 0 4px 12px rgba(0,0,0,.08);
        position: relative; padding: 2rem 2.25rem 1.5rem;
        animation: vsearch-panel-pop .25s cubic-bezier(.21,1.02,.73,1);
    }
    .vsearch__shell--modal .vsearch__body { grid-template-columns: 260px 1fr; gap: 2rem; }
    .vsearch__shell--modal .vsearch__sidebar { border-right: 0; }
    /* Mobile-Override: Body immer 1-spaltig, Sidebar als Drawer */
    @media (max-width: 820px) {
        .vsearch__shell--modal .vsearch__body { grid-template-columns: 1fr !important; gap: 0 !important; }
    }
    @keyframes vsearch-panel-pop { from { opacity: 0; transform: scale(.97) translateY(8px); } to { opacity: 1; transform: none; } }
    .vsearch--inline .vsearch__panel { background: transparent; }
    @keyframes vsearch-fade-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }

    /* Close-Button — !important wegen FFA/Theme-Konflikten */
    .vsearch__close {
        position: absolute !important; top: 1rem !important; right: 1rem !important; z-index: 10;
        width: 40px !important; height: 40px !important; min-width: 40px !important; max-width: 40px !important;
        padding: 0 !important; margin: 0 !important;
        border-radius: 50% !important; border: 0 !important;
        background: #f1f3f5 !important; color: #111 !important;
        cursor: pointer; display: inline-flex !important; align-items: center; justify-content: center;
        box-shadow: none !important; text-shadow: none !important;
        font: 0/0 monospace !important;
        flex: none !important;
        transition: background .15s, color .15s;
        overflow: hidden;
    }
    .vsearch__close:hover { background: #e4e6e9 !important; color: #000 !important; }
    .vsearch__close::before,
    .vsearch__close::after {
        content: "" !important; display: block !important;
        position: absolute !important;
        left: 50% !important; top: 50% !important;
        width: 18px !important; height: 2.5px !important;
        background: currentColor !important; border-radius: 2px !important;
        margin: 0 !important; padding: 0 !important;
        box-shadow: none !important;
    }
    .vsearch__close::before { transform: translate(-50%, -50%) rotate(45deg) !important; }
    .vsearch__close::after  { transform: translate(-50%, -50%) rotate(-45deg) !important; }
    .vsearch__shell--modal .vsearch__form { padding-right: 2.8rem; }

    /* Suchfeld */
    .vsearch__form { margin: 0 0 .9rem; }
    .vsearch__inputwrap { position: relative; }
    .vsearch__inputicon {
        position: absolute; left: 1rem; top: 50%; transform: translateY(-50%);
        color: var(--vs-text-muted); pointer-events: none;
    }
    .vsearch__input {
        width: 100% !important; max-width: none !important; min-width: 0 !important;
        box-sizing: border-box !important;
        padding: .85rem 2.6rem .85rem 2.8rem !important; font-size: 1.05rem;
        border: 1px solid var(--vs-border-strong); border-radius: 10px;
        background: var(--vs-bg); color: var(--vs-text);
        transition: border-color .15s, box-shadow .15s;
        display: block !important;
    }
    .vsearch__input:focus { outline: 0; border-color: var(--vs-accent); box-shadow: 0 0 0 3px var(--vs-accent-soft); }
    /* v2.2.0: Clear-Button im Input — sichtbar sobald Inhalt drin ist.
       Selektor mit doppelter Klassen-Specificity, damit FFA-Theme nicht
       in den absolute-Layout rein-grätscht (button[type=reset] oder
       .vsearch button waren Auslöser für "X fliegt außerhalb"). */
    .vsearch__inputwrap { position: relative !important; }
    .vsearch .vsearch__inputwrap .vsearch__clear {
        position: absolute !important;
        right: .7rem !important; left: auto !important;
        top: 50% !important; bottom: auto !important;
        transform: translateY(-50%) !important;
        width: 26px !important; height: 26px !important; min-width: 26px !important; max-width: 26px !important;
        padding: 0 !important; margin: 0 !important; border: 0 !important;
        border-radius: 50% !important; background: rgba(0,0,0,.06) !important; color: rgba(0,0,0,.55) !important;
        cursor: pointer; display: inline-flex !important; align-items: center; justify-content: center;
        box-shadow: none !important; flex: none !important; float: none !important;
        z-index: 2;
    }
    .vsearch .vsearch__inputwrap .vsearch__clear:hover { background: rgba(0,0,0,.12) !important; color: var(--vs-text) !important; }
    .vsearch .vsearch__inputwrap .vsearch__clear[hidden] { display: none !important; }

    /* Toolbar */
    .vsearch__toolbar { padding: .5rem 0 1rem; border-bottom: 1px solid var(--vs-border); margin-bottom: 1.1rem; }
    .vsearch__toolbar-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }

    /* Body: zweispaltig (Sidebar links + Hauptliste rechts) im Modal */
    .vsearch__body { display: grid; grid-template-columns: 240px 1fr; gap: 1.5rem; align-items: start; }
    .vsearch__body[hidden] { display: none; }
    .vsearch--inline .vsearch__body,
    .vsearch__shell:not(.vsearch__shell--modal) .vsearch__body { grid-template-columns: 1fr; }
    /* Initial-State: kein Filter → Sidebar verstecken, Treffer-Bereich volle Breite */
    .vsearch__body.vs-no-sidebar { grid-template-columns: 1fr; }
    .vsearch__body.vs-no-sidebar .vsearch__sidebar { display: none; }

    /* Sidebar */
    .vsearch__sidebar {
        position: sticky; top: 0;
        max-height: 70vh; overflow-y: auto;
        padding-right: .5rem;
        border-right: 1px solid var(--vs-border);
    }
    .vsearch--inline .vsearch__sidebar,
    .vsearch__shell:not(.vsearch__shell--modal) .vsearch__sidebar { border-right: 0; padding-right: 0; max-height: none; }
    .vsearch__sidebar-section { margin-bottom: 1.25rem; }
    .vsearch__sidebar-section:last-child { margin-bottom: 0; }
    .vsearch__sidebar-section[hidden] { display: none; }
    .vsearch__sidebar-title {
        font-size: .8rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em;
        color: var(--vs-text); margin: 0 0 .8rem; padding: 0 .7rem;
    }
    .vsearch__sidebar .vsearch__facets,
    .vsearch__sidebar .vsearch__ext-filters,
    .vsearch__sidebar .vsearch__tag-cloud {
        display: flex; flex-direction: column; gap: .35rem;
    }
    .vsearch__sidebar .vsearch__facet,
    .vsearch__sidebar .vsearch__ext-filter {
        width: 100%; text-align: left !important;
        padding: .55rem 1rem !important;
        border-radius: 999px !important;
        font-size: .9rem !important;
        background: rgba(74,128,135,.10) !important;
        border: 0 !important;
        color: var(--vs-text) !important;
        font-weight: 500 !important;
        transition: background .15s, color .15s;
    }
    .vsearch__sidebar .vsearch__facet:hover,
    .vsearch__sidebar .vsearch__ext-filter:hover {
        background: rgba(74,128,135,.18) !important;
        color: var(--vs-accent-strong) !important;
    }
    .vsearch__sidebar .vsearch__facet--active,
    .vsearch__sidebar .vsearch__ext-filter--active {
        background: var(--vs-accent) !important;
        color: #fff !important;
        font-weight: 600 !important;
    }
    .vsearch__sidebar .vsearch__facet-sep { display: none !important; }

    /* Main-Spalte */
    .vsearch__main { min-width: 0; }

    /* Filter-Toggle-Button (nur auf Mobile sichtbar) */
    .vsearch__filter-toggle {
        display: none; align-items: center; gap: .4rem;
        padding: .5rem .85rem !important; border: 1px solid var(--vs-border-strong) !important;
        background: var(--vs-bg) !important; color: var(--vs-text) !important;
        border-radius: 999px !important; font-size: .85rem !important; font-weight: 500 !important;
        cursor: pointer;
    }
    .vsearch__filter-toggle:hover { background: var(--vs-bg-soft) !important; }
    .vsearch__filter-toggle .vsearch__filter-toggle-badge {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 18px; height: 18px; padding: 0 5px;
        background: var(--vs-accent); color: #fff;
        border-radius: 999px; font-size: .7rem; font-weight: 700;
    }

    /* Drawer-Close-Button + Backdrop default aus (nur Mobile-Drawer braucht sie) */
    .vsearch__sidebar-close { display: none !important; }
    .vsearch__drawer-backdrop { display: none; }

    /* Responsive: bei <820px Sidebar als Drawer */
    @media (max-width: 820px) {
        .vsearch__body { grid-template-columns: 1fr; }
        .vsearch__filter-toggle { display: inline-flex; }
        .vsearch__sidebar {
            position: fixed; top: 0; left: 0; bottom: 0; width: 84%; max-width: 320px;
            background: var(--vs-bg); z-index: 10000;
            padding: 4rem 1.25rem 1.5rem; border-right: 1px solid var(--vs-border);
            box-shadow: 4px 0 24px rgba(0,0,0,.15);
            transform: translateX(-100%); transition: transform .25s ease-out;
            max-height: 100vh; overflow-y: auto;
        }
        .vsearch__sidebar.vs-drawer-open { transform: translateX(0); }
        .vsearch__sidebar::before {
            content: "Filter"; display: block;
            position: absolute; top: 1rem; left: 1.25rem;
            font-size: 1.05rem; font-weight: 700; color: var(--vs-text);
        }
        .vsearch__sidebar-close {
            position: absolute !important; top: .9rem !important; right: .9rem !important;
            width: 32px !important; height: 32px !important;
            border: 0 !important; border-radius: 50% !important;
            background: rgba(0,0,0,.06) !important; color: var(--vs-text) !important;
            cursor: pointer; display: flex !important; align-items: center; justify-content: center;
            font-size: 1.2rem; line-height: 1;
        }
        .vsearch__drawer-backdrop {
            display: block;
            position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 9999;
            opacity: 0; pointer-events: none; transition: opacity .2s;
        }
        .vsearch__drawer-backdrop.vs-drawer-open { opacity: 1; pointer-events: auto; }
    }
    .vsearch__meta { color: var(--vs-text-muted); font-size: .85rem; margin: 0; }
    .vsearch__facets { display: flex; gap: .35rem; flex-wrap: wrap; }

    /* Facet-Pills — !important wegen FFA-Theme */
    .vsearch__facet {
        padding: .3rem .8rem !important; font-size: .82rem !important;
        border: 1px solid var(--vs-border) !important;
        border-radius: 999px !important; cursor: pointer;
        background: var(--vs-bg) !important; color: var(--vs-text-muted) !important;
        box-shadow: none !important; text-shadow: none !important;
        transition: all .15s;
        font-weight: 500 !important;
    }
    .vsearch__facet:hover { border-color: var(--vs-accent) !important; color: var(--vs-accent) !important; background: var(--vs-bg) !important; }
    .vsearch__facet--active, .vsearch__facet--active:hover { background: var(--vs-accent) !important; color: #fff !important; border-color: var(--vs-accent) !important; }

    .vsearch__facet-sep { display: inline-block; width: 1px; height: 18px; background: var(--vs-border); margin: 0 .15rem; align-self: center; }
    .vsearch__facet--tag                 { background: #dbeafe !important; color: #1e40af !important; border-color: transparent !important; }
    .vsearch__facet--tag[data-color="green"]  { background: #d1fae5 !important; color: #065f46 !important; }
    .vsearch__facet--tag[data-color="red"]    { background: #fee2e2 !important; color: #991b1b !important; }
    .vsearch__facet--tag[data-color="orange"] { background: #fed7aa !important; color: #9a3412 !important; }
    .vsearch__facet--tag[data-color="purple"] { background: #e9d5ff !important; color: #6b21a8 !important; }
    .vsearch__facet--tag[data-color="pink"]   { background: #fce7f3 !important; color: #9d174d !important; }
    .vsearch__facet--tag[data-color="gray"]   { background: #e5e7eb !important; color: #374151 !important; }
    .vsearch__facet--tag[data-color="teal"]   { background: #ccfbf1 !important; color: #115e59 !important; }
    .vsearch__facet--tag:hover { filter: brightness(.96); }
    .vsearch__facet--tag-active                 { background: #1e40af !important; color: #fff !important; }
    .vsearch__facet--tag-active[data-color="green"]  { background: #065f46 !important; color: #fff !important; }
    .vsearch__facet--tag-active[data-color="red"]    { background: #991b1b !important; color: #fff !important; }
    .vsearch__facet--tag-active[data-color="orange"] { background: #9a3412 !important; color: #fff !important; }
    .vsearch__facet--tag-active[data-color="purple"] { background: #6b21a8 !important; color: #fff !important; }
    .vsearch__facet--tag-active[data-color="pink"]   { background: #9d174d !important; color: #fff !important; }
    .vsearch__facet--tag-active[data-color="gray"]   { background: #374151 !important; color: #fff !important; }
    .vsearch__facet--tag-active[data-color="teal"]   { background: #115e59 !important; color: #fff !important; }

    /* === Trefferliste === */
    .vsearch__results { margin: 0; max-height: 70vh; overflow-y: auto; padding-right: .5rem; scroll-behavior: smooth; }
    .vsearch__results::-webkit-scrollbar { width: 8px; }
    .vsearch__results::-webkit-scrollbar-thumb { background: rgba(0,0,0,.15); border-radius: 8px; }
    .vsearch__results::-webkit-scrollbar-thumb:hover { background: rgba(0,0,0,.28); }
    .vsearch__list { list-style: none !important; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .7rem; }
    .vsearch__list li.vs-active {
        border-color: var(--vs-accent) !important;
        box-shadow: 0 0 0 2px var(--vs-accent-soft), var(--vs-shadow-card-hover) !important;
    }
    .vsearch__list.vs-is-loading { opacity: .55; pointer-events: none; transition: opacity .15s ease-out; }

    /* Mehr-laden-Button */
    .vsearch__loadmore {
        display: block; margin: 1rem auto 0;
        padding: .65rem 1.5rem !important; border: 1px solid var(--vs-border-strong) !important;
        background: var(--vs-bg) !important; color: var(--vs-text) !important;
        border-radius: 999px !important; font-size: .9rem !important; font-weight: 500 !important;
        cursor: pointer; transition: background .15s, border-color .15s, color .15s;
        box-shadow: var(--vs-shadow-card) !important;
    }
    .vsearch__loadmore:hover:not(:disabled) {
        background: var(--vs-accent) !important; border-color: var(--vs-accent) !important; color: #fff !important;
    }
    .vsearch__loadmore:disabled { opacity: .6; cursor: wait; }
    .vsearch__list li {
        list-style: none !important; padding: 0;
        border: 1px solid var(--vs-border); border-radius: var(--vs-radius);
        background: var(--vs-bg); box-shadow: var(--vs-shadow-card);
        transition: border-color .15s, box-shadow .2s, transform .15s;
    }
    .vsearch__list li::before, .vsearch__list li::marker { content: none !important; display: none !important; }
    .vsearch__list li:hover {
        border-color: var(--vs-accent);
        box-shadow: var(--vs-shadow-card-hover);
        transform: translateY(-1px);
    }
    .vsearch__list a {
        color: inherit; text-decoration: none;
        display: flex; gap: 1.1rem; padding: 1.1rem 1.25rem;
        align-items: stretch;
    }
    /* Modal-Modus (Sinos-Style): borderlose Karten, dünner Separator dazwischen,
       großes Hero-Bild links, snippet in Akzent-Farbe */
    .vsearch--modal .vsearch__list { gap: 0; }
    .vsearch--modal .vsearch__list li {
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        background: transparent !important;
        border-bottom: 1px solid var(--vs-border) !important;
    }
    .vsearch--modal .vsearch__list li:last-child { border-bottom: 0 !important; }
    .vsearch--modal .vsearch__list li:hover {
        transform: none !important;
        background: var(--vs-bg-soft) !important;
        border-bottom-color: var(--vs-border) !important;
    }
    .vsearch--modal .vsearch__list a { padding: 1.5rem 1rem; gap: 1.5rem; }
    .vsearch--modal .vs-icon--cover { width: 180px !important; min-height: 130px !important; border-radius: 4px !important; }
    .vsearch--modal .vs-icon--big { width: 180px !important; min-height: 130px !important; border-radius: 4px !important; }
    .vs-title { font-size: 1.05rem !important; }
    .vsearch--modal .vs-title { font-size: 1.05rem !important; font-weight: 700 !important; white-space: normal !important; line-height: 1.4 !important; }
    .vs-snippet { font-size: .92rem; -webkit-line-clamp: 2; }
    .vsearch--modal .vs-snippet { -webkit-line-clamp: 3; color: var(--vs-accent-strong); margin-top: .35rem; }
    .vsearch--modal .vs-url { display: block; width: 100%; flex: none; color: var(--vs-text-muted); margin-top: .3rem; font-size: .82rem; word-break: break-all; white-space: normal; }
    .vsearch--modal .vs-meta { gap: .35rem; }
    .vsearch--modal .vs-badge, .vsearch--modal .vs-meta-dot { display: none; }
    .vsearch--modal .vs-meta .vs-date { font-size: .78rem; color: var(--vs-text-soft); }
    .vsearch--modal .vs-tags { display: none; }

    /* Visual (Cover oder Icon) */
    .vs-icon {
        flex-shrink: 0; width: 56px; height: 56px;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: 10px; background: var(--vs-accent-soft); color: var(--vs-accent);
    }
    .vs-icon--file { background: #f3f4f6; color: #4b5563; }
    .vs-icon--pdf { background: #fee2e2; color: #b91c1c; }
    .vs-icon--docx, .vs-icon--doc { background: #dbeafe; color: #1d4ed8; }
    .vs-icon--xlsx, .vs-icon--xls { background: #d1fae5; color: #047857; }
    .vs-icon--pptx, .vs-icon--ppt { background: #fed7aa; color: #c2410c; }
    .vs-icon--odt { background: #e0e7ff; color: #4338ca; }
    .vs-icon--rtf { background: #f3e8ff; color: #7e22ce; }
    .vs-icon--txt, .vs-icon--md { background: #f3f4f6; color: #374151; }
    /* GROßES Placeholder-Icon im Cover-Format wenn kein cover_url vorhanden.
       Sichtbarer "wir konnten kein Bild finden"-Ersatz statt 56px-Briefmarke. */
    .vs-icon--big {
        width: 120px !important;
        height: auto !important;
        min-height: 120px !important;
        border-radius: 14px !important;
        flex-shrink: 0 !important;
        flex-grow: 0 !important;
        align-self: stretch !important;
    }
    .vs-icon--crawled.vs-icon--big {
        background: linear-gradient(135deg, #ede9fe 0%, #ddd6fe 100%);
        color: #5b21b6;
    }
    .vs-icon--page.vs-icon--big {
        background: linear-gradient(135deg, var(--vs-accent-soft) 0%, rgba(74,128,135,.18) 100%);
        color: var(--vs-accent-strong);
    }
    @media (max-width: 600px) {
        .vs-icon--big { width: 90px !important; min-height: 90px !important; border-radius: 12px !important; }
    }
    /* Cover-Visual: GROSS, anschaulich, füllt die Karte vom oberen bis unteren
       Rand. Fixe Breite, height auto + min-height sorgt für Stretch über die
       komplette Treffer-Karte. !important wegen FFA/Contao-Theme-Overrides. */
    .vs-icon--cover {
        background: #f3f4f6 !important;
        padding: 0 !important;
        overflow: hidden !important;
        width: 120px !important;
        height: auto !important;
        min-height: 120px !important;
        flex-shrink: 0 !important;
        flex-grow: 0 !important;
        border: 0 !important;
        border-radius: 14px !important;
        align-self: stretch !important;
    }
    .vs-cover-img {
        width: 100% !important;
        height: 100% !important;
        min-height: 120px !important;
        object-fit: cover !important;
        object-position: center !important;
        display: block !important;
        border-radius: inherit !important;
    }
    @media (max-width: 600px) {
        .vs-icon--cover { width: 90px !important; min-height: 90px !important; border-radius: 12px !important; }
        .vs-cover-img { min-height: 90px !important; }
    }

    /* Body */
    .vs-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .25rem; }

    /* Titel-Zeile: Titel + ggf. Tags + Schloss in einer Reihe */
    .vs-title-row {
        display: flex; align-items: center; gap: .5rem; flex-wrap: wrap;
        min-width: 0;
    }
    .vs-title {
        font-weight: 600; font-size: 1rem; color: var(--vs-text);
        margin: 0; line-height: 1.35;
        flex: 1 1 auto; min-width: 0;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .vs-lock {
        display: inline-flex; align-items: center; justify-content: center;
        width: 18px; height: 18px;
        color: #a16207; background: rgba(202, 138, 4, 0.12); border-radius: 4px;
        flex-shrink: 0;
    }

    /* Meta-Zeile: Typ-Badge + Datum + Größe + URL */
    .vs-meta {
        display: flex; align-items: center; gap: .5rem; flex-wrap: wrap;
        font-size: .78rem; color: var(--vs-text-muted); line-height: 1.4;
    }
    .vs-badge {
        display: inline-flex; align-items: center;
        padding: .1rem .45rem;
        font-size: .68rem; font-weight: 700; letter-spacing: .02em;
        text-transform: uppercase;
        border-radius: 4px;
        background: var(--vs-bg-soft); color: var(--vs-text-muted);
        border: 1px solid var(--vs-border);
    }
    .vs-badge--page { background: var(--vs-accent-soft); color: var(--vs-accent-strong); border-color: transparent; }
    .vs-badge--crawled { background: #ede9fe; color: #5b21b6; border-color: transparent; }
    .vs-badge--pdf { background: #fee2e2; color: #b91c1c; border-color: transparent; }
    .vs-badge--docx, .vs-badge--doc { background: #dbeafe; color: #1d4ed8; border-color: transparent; }
    .vs-badge--xlsx, .vs-badge--xls { background: #d1fae5; color: #047857; border-color: transparent; }
    .vs-badge--pptx, .vs-badge--ppt { background: #fed7aa; color: #c2410c; border-color: transparent; }
    .vs-badge--odt { background: #e0e7ff; color: #4338ca; border-color: transparent; }
    .vs-meta-dot { color: var(--vs-text-soft); font-weight: 700; line-height: 1; }
    .vs-url {
        color: var(--vs-text-soft);
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        min-width: 0; flex: 1 1 200px;
    }

    /* Snippet */
    .vs-snippet {
        font-size: .9rem; color: var(--vs-text); line-height: 1.55;
        margin: .25rem 0 0;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .vsearch__list mark { background: var(--vs-mark); color: var(--vs-text); padding: 0 2px; border-radius: 2px; font-weight: 600; }

    /* Tag-Chips: rechts neben Titel (kompakt) */
    .vs-tags {
        display: inline-flex; flex-wrap: wrap; gap: .3rem;
        flex-shrink: 0;
    }
    .vs-tag {
        display: inline-flex; align-items: center;
        padding: .1rem .5rem; font-size: .7rem; font-weight: 500;
        border-radius: 999px; background: #dbeafe; color: #1e40af;
        line-height: 1.4; white-space: nowrap;
    }
    .vs-tag[data-color="green"]  { background: #d1fae5; color: #065f46; }
    .vs-tag[data-color="red"]    { background: #fee2e2; color: #991b1b; }
    .vs-tag[data-color="orange"] { background: #fed7aa; color: #9a3412; }
    .vs-tag[data-color="purple"] { background: #e9d5ff; color: #6b21a8; }
    .vs-tag[data-color="pink"]   { background: #fce7f3; color: #9d174d; }
    .vs-tag[data-color="gray"]   { background: #e5e7eb; color: #374151; }
    .vs-tag[data-color="teal"]   { background: #ccfbf1; color: #115e59; }
    .vs-tag[data-boost="1"] { box-shadow: inset 0 0 0 1px currentColor; padding-left: .3rem; }
    .vs-tag[data-boost="1"] .vs-tag-pin { display: inline-block; width: 9px; height: 9px; margin-right: .2rem; opacity: .9; }

    /* Empty-State */
    .vsearch__empty { padding: 2.5rem 1rem; text-align: center; color: var(--vs-text-muted); }
    .vsearch__empty-icon { color: rgba(0,0,0,.18); margin-bottom: .8rem; }
    .vsearch__empty-title { font-size: 1.05rem; font-weight: 600; color: var(--vs-text); margin: 0 0 .35rem; }
    .vsearch__empty-hint { font-size: .9rem; margin: 0 0 .8rem; }
    .vsearch__empty-tips { display: flex; flex-wrap: wrap; gap: .4rem; justify-content: center; margin-top: .5rem; }
    .vsearch__empty-recent { margin-top: 1.25rem; }
    .vsearch__empty-recent-label { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--vs-text-muted); margin-bottom: .25rem; }
    .vsearch__empty-tip {
        padding: .3rem .7rem; font-size: .78rem; font-weight: 500;
        border: 1px solid var(--vs-border); border-radius: 999px;
        background: var(--vs-bg); color: var(--vs-text);
        cursor: pointer; transition: all .12s;
    }
    .vsearch__empty-tip:hover { border-color: var(--vs-accent); color: var(--vs-accent); }
    /* Tag-Variante im Initial-State — übernimmt Farbpalette der Tag-Chips,
       damit der User „Beliebte Tags" sofort als Tag-Vorschläge erkennt. */
    .vsearch__empty-tip--tag                  { background: #dbeafe; color: #1e40af; border-color: transparent; }
    .vsearch__empty-tip--tag[data-color="green"]  { background: #d1fae5; color: #065f46; }
    .vsearch__empty-tip--tag[data-color="red"]    { background: #fee2e2; color: #991b1b; }
    .vsearch__empty-tip--tag[data-color="orange"] { background: #fed7aa; color: #9a3412; }
    .vsearch__empty-tip--tag[data-color="purple"] { background: #e9d5ff; color: #6b21a8; }
    .vsearch__empty-tip--tag[data-color="pink"]   { background: #fce7f3; color: #9d174d; }
    .vsearch__empty-tip--tag[data-color="gray"]   { background: #e5e7eb; color: #374151; }
    .vsearch__empty-tip--tag[data-color="teal"]   { background: #ccfbf1; color: #115e59; }
    .vsearch__empty-tip--tag:hover { filter: brightness(.95); border-color: transparent; }

    /* Skeleton-Loading */
    .vsearch__skeleton { list-style: none !important; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .6rem; }
    .vsearch__skel-card {
        list-style: none !important;
        display: flex; gap: 1rem; padding: .95rem 1.1rem;
        border: 1px solid var(--vs-border); border-radius: var(--vs-radius); background: var(--vs-bg);
    }
    .vsearch__skel-icon { width: 56px; height: 56px; border-radius: 10px; flex-shrink: 0; }
    .vsearch__skel-body { flex: 1; display: flex; flex-direction: column; gap: .4rem; }
    .vsearch__skel-line { height: .7rem; border-radius: 3px; }
    .vsearch__skel-line--title { width: 70%; height: .9rem; }
    .vsearch__skel-line--meta { width: 50%; }
    .vsearch__skel-line--snippet { width: 95%; }
    .vsearch__skel-line--snippet2 { width: 80%; }
    .vsearch__skel-icon, .vsearch__skel-line {
        background: linear-gradient(90deg, #eef0f3 0%, #f7f8fa 50%, #eef0f3 100%);
        background-size: 200% 100%;
        animation: vsearch-shimmer 1.4s ease-in-out infinite;
    }
    @keyframes vsearch-shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    /* v2.1.0: Sort + Ext-Filter */
    .vsearch__sort { display: inline-flex; align-items: center; gap: .4rem; font-size: .82rem; color: var(--vs-text-muted); }
    .vsearch__sort-label { font-weight: 500; }
    .vsearch__sort-select {
        padding: .25rem .5rem;
        border: 1px solid var(--vs-border); border-radius: 6px; background: var(--vs-bg);
        font: inherit; font-size: .82rem; color: var(--vs-text); cursor: pointer;
    }
    .vsearch__sort-select:focus { outline: 2px solid var(--vs-accent); outline-offset: 1px; }

    /* Sort-Pills — minimalistisch, Underline-Indikator wie Apple/Linear */
    .vsearch__sort-pills {
        display: inline-flex; align-items: center; gap: .15rem;
        padding: 0; background: transparent !important;
        border: 0 !important; border-radius: 0 !important;
        box-shadow: none !important;
    }
    .vsearch__sort-pill {
        position: relative;
        display: inline-flex !important; align-items: center; gap: .35rem;
        padding: .35rem .7rem !important; border: 0 !important;
        background: transparent !important; color: #6b7280 !important;
        border-radius: 6px !important; font-size: .8rem !important; font-weight: 500 !important;
        cursor: pointer;
        transition: color .15s ease, background .15s ease;
        box-shadow: none !important; line-height: 1.2 !important;
        white-space: nowrap;
    }
    .vsearch__sort-pill .vsearch__sort-icon {
        flex-shrink: 0; opacity: .55;
    }
    .vsearch__sort-pill:hover { color: var(--vs-text) !important; background: rgba(0,0,0,.03) !important; }
    .vsearch__sort-pill:hover .vsearch__sort-icon { opacity: .85; }
    .vsearch__sort-pill--active {
        color: var(--vs-accent-strong) !important;
        background: transparent !important;
        font-weight: 600 !important;
    }
    .vsearch__sort-pill--active .vsearch__sort-icon { opacity: 1; color: var(--vs-accent-strong); }
    .vsearch__sort-pill--active::after {
        content: ""; position: absolute;
        left: .7rem; right: .7rem; bottom: -2px;
        height: 2px; border-radius: 2px;
        background: var(--vs-accent-strong);
    }
    .vsearch__sort-pill:focus-visible {
        outline: 2px solid var(--vs-accent); outline-offset: 2px;
    }

    .vsearch__ext-filters {
        display: flex; flex-wrap: wrap; gap: .35rem;
        margin-top: .4rem; padding-top: .4rem;
        border-top: 1px dashed var(--vs-border); align-items: center;
    }
    .vsearch__ext-filter {
        padding: .2rem .65rem; font-size: .78rem; font-weight: 500;
        border: 1px solid var(--vs-border); border-radius: 999px;
        background: var(--vs-bg); color: var(--vs-text);
        cursor: pointer; transition: all .12s;
    }
    .vsearch__ext-filter:hover { border-color: var(--vs-accent); color: var(--vs-accent); }
    .vsearch__ext-filter--active { background: var(--vs-accent); color: #fff; border-color: var(--vs-accent); }

    /* === Mobile-Breakpoints === */
    @media (max-width: 600px) {
        /* Modal-Shell: Vollbild auf Mobile statt Fenster mit Rand */
        .vsearch__shell--modal { padding: 0; align-items: stretch; }
        .vsearch__shell--modal .vsearch__panel {
            max-width: 100%; width: 100%; height: 100%;
            border-radius: 0;
            padding: 1rem 1rem .75rem;
            display: flex; flex-direction: column;
            box-shadow: none;
        }
        /* Modal-Close größer + immer top-rechts */
        .vsearch__close { top: .5rem !important; right: .5rem !important; width: 40px !important; height: 40px !important; }
        .vsearch__shell--modal .vsearch__form { padding-right: 3rem; margin-bottom: .65rem; }
        /* Suchfeld größer (Mobile Daumen-freundlich) */
        .vsearch__input { font-size: 1rem; padding: .9rem 1rem .9rem 2.8rem; }
        .vsearch__inputicon { left: 1rem; }

        /* Toolbar als 2-Reihen-Layout: Treffer-Count + Filter-Button oben, Sort-Pills horizontal scrollbar */
        .vsearch__toolbar { padding: .35rem 0 .7rem; margin-bottom: .7rem; }
        .vsearch__toolbar-row { gap: .5rem; flex-wrap: wrap; }
        .vsearch__sort-pills {
            order: 3; width: 100%;
            overflow-x: auto; flex-wrap: nowrap;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }
        .vsearch__sort-pills::-webkit-scrollbar { display: none; }
        .vsearch__sort-pill { flex-shrink: 0; padding: .5rem .85rem !important; font-size: .82rem !important; gap: .35rem !important; }

        /* Body: einspaltig, Sidebar wird zum Drawer (siehe @820px-Regel) */
        .vsearch__body { gap: .8rem; }
        .vsearch__results { max-height: calc(100vh - 200px); flex: 1; }

        /* Treffer-Karten kompakter */
        .vsearch__list a { padding: .9rem .85rem; gap: .85rem; }
        .vsearch--modal .vsearch__list a { padding: 1rem .5rem; gap: .9rem; }
        .vs-icon--cover { width: 80px !important; min-height: 80px !important; }
        .vs-icon--big { width: 80px !important; min-height: 80px !important; }
        .vsearch--modal .vs-icon--cover, .vsearch--modal .vs-icon--big { width: 90px !important; min-height: 90px !important; }
        .vs-title { font-size: .95rem; white-space: normal; }
        .vsearch--modal .vs-title { font-size: 1rem !important; }
        .vs-snippet { font-size: .85rem; -webkit-line-clamp: 3; }
        .vsearch--modal .vs-snippet { -webkit-line-clamp: 2; font-size: .85rem; }
        .vs-meta { font-size: .72rem; }
        .vsearch--modal .vs-url { font-size: .75rem; }

        /* Filter-Toggle größer und prominent */
        .vsearch__filter-toggle { padding: .55rem 1rem !important; font-size: .9rem !important; }

        /* Initial-State zentriert mit etwas Luft */
        .vsearch__empty-initial { padding: 3rem 1rem; }
    }
</style>

<script>
(function () {
    'use strict';
    var boxes = document.querySelectorAll('[data-vsearch]:not([data-vsearch-init])');
    if (!boxes.length) return;

    boxes.forEach(function (box) {
        box.setAttribute('data-vsearch-init', '1');

        var mode = box.dataset.mode;
        var input = box.querySelector('[data-vsearch-input]');
        var clearBtn = box.querySelector('[data-vsearch-clear]');
        var resultsBox = box.querySelector('[data-vsearch-results]');
        var resultsList = box.querySelector('[data-vsearch-list]');
        var toolbar = box.querySelector('[data-vsearch-toolbar]');
        var bodyBox = box.querySelector('[data-vsearch-body]');
        var meta = box.querySelector('[data-vsearch-meta]');
        var facetsBox = box.querySelector('[data-vsearch-facets]');
        var sortSelect = box.querySelector('[data-vsearch-sort]');
        var extFiltersBox = box.querySelector('[data-vsearch-ext-filters]');
        var moduleIdForStorage = box.dataset.moduleId || '0';
        var RECENT_KEY = 'vsearch.recent.' + moduleIdForStorage;
        var RECENT_MAX = 6;
        var apiUrl = box.dataset.apiUrl;
        var locale = box.dataset.locale;
        var minChars = parseInt(box.dataset.minChars, 10) || 3;
        var limit = parseInt(box.dataset.limit, 10) || 10;
        var openInNewTab = box.dataset.openNewTab === '1';
        var showFiletypeFilter = box.dataset.showFiletypeFilter === '1';
        // i18n-Map vom PHP-Template (pro Page-Locale). T(key) liefert den
        // uebersetzten String, fallback ist der Schluessel selbst.
        var I18N = {};
        try { I18N = JSON.parse(box.dataset.i18n || '{}'); } catch (e) { I18N = {}; }
        function T(key, vars) {
            var s = I18N[key] || key;
            if (vars) {
                Object.keys(vars).forEach(function (k) {
                    s = s.replace('{' + k + '}', vars[k]);
                });
            }
            return s;
        }

        var FILETYPE_GROUPS = [
            { key: 'pdf',   label: 'PDF',     exts: ['pdf'] },
            { key: 'excel', label: 'Excel',   exts: ['xlsx', 'xls'] },
            { key: 'word',  label: 'Word',    exts: ['docx', 'doc'] },
            { key: 'text',  label: 'Text',    exts: ['txt', 'md'] },
            { key: 'odt',   label: 'OpenDoc', exts: ['odt'] },
            { key: 'rtf',   label: 'RTF',     exts: ['rtf'] }
        ];

        var TYPE_LABELS = {
            page: T('typePage'), file: T('typeFile'), article: T('typeArticle'), crawled: T('typeCrawled'),
            pdf: 'PDF', docx: 'DOCX', doc: 'DOC',
            xlsx: 'XLSX', xls: 'XLS', pptx: 'PPTX', ppt: 'PPT',
            odt: 'ODT', rtf: 'RTF', txt: 'TXT', md: 'MD'
        };

        var debounceTimer = null;
        var lastQuery = '';
        var ctrl = null;
        var currentOffset = 0;
        var lastTotalHits = 0;
        var currentTypeFilter = '';
        var currentTagFilters = [];
        var currentSort = 'relevance';
        var currentExtGroups = [];
        var lastTagFacets = [];
        // Snapshot-Strategie fuer Sidebar-Pills:
        // - lastFullTypeFacets: Type-Counts ohne irgendwelche Filter (Tag oder Type).
        //   Wird genutzt wenn auch der Tag-Filter inaktiv ist.
        // - lastTagFilteredTypeFacets: Type-Counts mit aktivem Tag-Filter,
        //   aber OHNE Type-Filter. Wird genutzt wenn der User einen Type-Filter
        //   ueber einem Tag-Filter setzt — die anderen Pills muessen sichtbar
        //   bleiben, aber mit Counts die zum Tag-Filter passen.
        // - lastFullTagFacets: Tag-Counts ohne Type-Filter.
        var lastFullTypeFacets = {};
        var lastTagFilteredTypeFacets = {};
        var lastFullTagFacets = [];
        // Cache für "Initial-State"-Tag-Cloud: einmal pro Modal-Session laden
        // damit das leere Such-Panel direkt populäre Tags zum Anklicken anbietet.
        var initialTagFacets = null;
        var initialTagFacetsLoading = false;

        // URL-State (siehe v2.1.0)
        var hashPrefix = 'vs' + (box.dataset.moduleId || '0');
        var suppressHashUpdate = false;

        function serializeState() {
            var parts = [];
            var q = input.value.trim();
            if (q) parts.push('q=' + encodeURIComponent(q));
            if (currentTypeFilter) parts.push('type=' + encodeURIComponent(currentTypeFilter));
            if (currentTagFilters.length) parts.push('tags=' + encodeURIComponent(currentTagFilters.join(',')));
            if (currentSort && currentSort !== 'relevance') parts.push('sort=' + encodeURIComponent(currentSort));
            if (currentExtGroups.length) parts.push('ext=' + encodeURIComponent(currentExtGroups.join(',')));
            if (!parts.length) return '';
            return hashPrefix + ':' + parts.join('&');
        }

        function parseState(rawHash) {
            if (!rawHash) return null;
            var blocks = rawHash.replace(/^#/, '').split('|');
            for (var i = 0; i < blocks.length; i++) {
                var block = blocks[i];
                if (block.indexOf(hashPrefix + ':') !== 0) continue;
                var payload = block.substring(hashPrefix.length + 1);
                var state = { q: '', type: '', tags: [], sort: 'relevance', ext: [] };
                payload.split('&').forEach(function (kv) {
                    var idx = kv.indexOf('=');
                    if (idx < 0) return;
                    var k = kv.substring(0, idx);
                    var v = decodeURIComponent(kv.substring(idx + 1));
                    if (k === 'q') state.q = v;
                    else if (k === 'type') state.type = v;
                    else if (k === 'tags') state.tags = v ? v.split(',').filter(Boolean) : [];
                    else if (k === 'sort') state.sort = v;
                    else if (k === 'ext') state.ext = v ? v.split(',').filter(Boolean) : [];
                });
                return state;
            }
            return null;
        }

        function updateHash() {
            if (suppressHashUpdate) return;
            var ours = serializeState();
            var rawHash = window.location.hash.replace(/^#/, '');
            var keptBlocks = rawHash.split('|').filter(function (b) {
                return b !== '' && b.indexOf(hashPrefix + ':') !== 0;
            });
            if (ours) keptBlocks.push(ours);
            var newHash = keptBlocks.length ? '#' + keptBlocks.join('|') : '';
            try {
                if (window.location.hash !== newHash) {
                    window.history.replaceState(null, '', window.location.pathname + window.location.search + newHash);
                }
            } catch (e) {}
        }

        function pushHashBeforeNavigate() {
            var ours = serializeState();
            var rawHash = window.location.hash.replace(/^#/, '');
            var keptBlocks = rawHash.split('|').filter(function (b) {
                return b !== '' && b.indexOf(hashPrefix + ':') !== 0;
            });
            if (ours) keptBlocks.push(ours);
            var newHash = keptBlocks.length ? '#' + keptBlocks.join('|') : '';
            try {
                window.history.pushState(null, '', window.location.pathname + window.location.search + newHash);
            } catch (e) {}
        }

        function restoreFromHash() {
            var state = parseState(window.location.hash);
            if (!state || !state.q) return false;
            suppressHashUpdate = true;
            try {
                input.value = state.q;
                lastQuery = state.q;
                currentTypeFilter = state.type || '';
                currentTagFilters = Array.isArray(state.tags) ? state.tags : [];
                currentSort = state.sort || 'relevance';
                currentExtGroups = Array.isArray(state.ext) ? state.ext : [];
                if (sortSelect) sortSelect.value = currentSort;
                syncSortPills(currentSort);
                toggleClearBtn();
                runSearch(state.q);
            } finally {
                setTimeout(function () { suppressHashUpdate = false; }, 0);
            }
            return true;
        }

        // Modal
        if (mode === 'modal') {
            var trigger = box.querySelector('[data-vsearch-trigger]');
            var shell = box.querySelector('[data-vsearch-shell]');
            var close = box.querySelector('[data-vsearch-close]');

            window.__vsearchOpenModal = function () { openModal(); };
            window.__vsearchCloseModal = function () { closeModal(); };

            function openModal() {
                shell.hidden = false;
                document.body.style.overflow = 'hidden';
                setTimeout(function () { input.focus(); }, 60);
                // Initial-State: zeige Recent Searches sofort, OHNE auf Tippen zu warten
                if (!input.value) showInitialState();
            }
            function closeModal() {
                shell.hidden = true;
                document.body.style.overflow = '';
                resultsBox.hidden = true;
                if (toolbar) toolbar.hidden = true;
                if (bodyBox) bodyBox.hidden = true;
                input.value = '';
                lastQuery = '';
                currentTypeFilter = '';
                currentTagFilters = [];
                currentSort = 'relevance';
                currentExtGroups = [];
                if (sortSelect) sortSelect.value = 'relevance';
                syncSortPills('relevance');
                toggleClearBtn();
                updateHash();
            }

            trigger.addEventListener('click', openModal);
            close.addEventListener('click', closeModal);
            shell.addEventListener('click', function (e) { if (e.target === shell) closeModal(); });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !shell.hidden) closeModal();
            });
            document.addEventListener('keydown', function (e) {
                if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                    e.preventDefault();
                    if (shell.hidden) openModal(); else closeModal();
                }
            });
        }

        function toggleClearBtn() {
            if (!clearBtn) return;
            clearBtn.hidden = !input.value;
        }
        if (clearBtn) {
            clearBtn.addEventListener('click', function () {
                input.value = '';
                lastQuery = '';
                toggleClearBtn();
                resultsBox.hidden = true;
                if (toolbar) toolbar.hidden = true;
                if (bodyBox) bodyBox.hidden = true;
                input.focus();
                updateHash();
            });
        }

        input.addEventListener('input', function () {
            toggleClearBtn();
            var q = input.value.trim();
            if (q.length < minChars) {
                resultsBox.hidden = true;
                if (toolbar) toolbar.hidden = true;
                if (bodyBox) bodyBox.hidden = true;
                return;
            }
            if (q === lastQuery) return;
            lastQuery = q;
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(function () { runSearch(q); }, 220);
        });

        function runSearch(q, opts) {
            opts = opts || {};
            var append = opts.append === true;
            if (!append) currentOffset = 0;
            if (ctrl) ctrl.abort();
            ctrl = new AbortController();
            var url = apiUrl + '?q=' + encodeURIComponent(q) + '&locale=' + encodeURIComponent(locale) + '&limit=' + limit + '&offset=' + currentOffset;
            if (currentTypeFilter) url += '&type=' + encodeURIComponent(currentTypeFilter);
            currentTagFilters.forEach(function (slug) { url += '&tags[]=' + encodeURIComponent(slug); });
            if (currentSort && currentSort !== 'relevance') url += '&sort=' + encodeURIComponent(currentSort);
            if (currentExtGroups.length && (currentTypeFilter === '' || currentTypeFilter === 'file')) {
                currentExtGroups.forEach(function (groupKey) {
                    var grp = FILETYPE_GROUPS.filter(function (g) { return g.key === groupKey; })[0];
                    if (!grp) return;
                    grp.exts.forEach(function (ext) { url += '&ext[]=' + encodeURIComponent(ext); });
                });
            }

            updateHash();
            resultsBox.hidden = false;
            if (bodyBox) bodyBox.hidden = false;
            // Bei erstem Suchlauf: Skeleton. Bei Folge-Suchen: bestehende
            // Treffer nur dimmen — verhindert Flackern, vermittelt Stabilität.
            if (!append && (resultsList.children.length === 0 || resultsList.querySelector('.vsearch__empty, .vsearch__skel-card, .vsearch__empty-initial'))) {
                renderSkeleton();
            } else if (!append) {
                resultsList.classList.add('vs-is-loading');
            }

            fetch(url, { signal: ctrl.signal, headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    resultsList.classList.remove('vs-is-loading');
                    render(data, q, append);
                })
                .catch(function (err) {
                    if (err.name === 'AbortError') return;
                    resultsList.classList.remove('vs-is-loading');
                    resultsList.innerHTML = '<li class="vsearch__empty"><p class="vsearch__empty-title">' + escapeHtml(T('searchError')) + '</p><p class="vsearch__empty-hint">' + escapeHtml(T('searchErrorHint')) + '</p></li>';
                });
        }

        if (sortSelect) {
            sortSelect.addEventListener('change', function () {
                currentSort = sortSelect.value || 'relevance';
                if (lastQuery) runSearch(lastQuery);
            });
        }
        // Mobile-Filter-Drawer
        var filterToggle = box.querySelector('[data-vsearch-filter-toggle]');
        var sidebar = box.querySelector('[data-vsearch-sidebar]');
        var drawerBackdrop = null;
        if (filterToggle && sidebar) {
            drawerBackdrop = document.createElement('div');
            drawerBackdrop.className = 'vsearch__drawer-backdrop';
            sidebar.parentNode.insertBefore(drawerBackdrop, sidebar);
            var closeBtn = document.createElement('button');
            closeBtn.type = 'button';
            closeBtn.className = 'vsearch__sidebar-close';
            closeBtn.setAttribute('aria-label', 'Filter schließen');
            closeBtn.innerHTML = '×';
            sidebar.appendChild(closeBtn);
            function openDrawer() { sidebar.classList.add('vs-drawer-open'); drawerBackdrop.classList.add('vs-drawer-open'); }
            function closeDrawer() { sidebar.classList.remove('vs-drawer-open'); drawerBackdrop.classList.remove('vs-drawer-open'); }
            filterToggle.addEventListener('click', openDrawer);
            closeBtn.addEventListener('click', closeDrawer);
            drawerBackdrop.addEventListener('click', closeDrawer);
        }
        var sortPillsBox = box.querySelector('[data-vsearch-sort-pills]');
        if (sortPillsBox) {
            Array.from(sortPillsBox.querySelectorAll('[data-sort]')).forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var s = btn.dataset.sort;
                    currentSort = s || 'relevance';
                    sortPillsBox.querySelectorAll('[data-sort]').forEach(function (b) {
                        b.classList.toggle('vsearch__sort-pill--active', b === btn);
                        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
                    });
                    if (lastQuery || currentTagFilters.length || currentTypeFilter || currentExtGroups.length) runSearch(lastQuery);
                });
            });
        }

        function renderSkeleton() {
            // 3 Skeleton-Karten — gibt visuelles Feedback dass was passiert,
            // ohne den vorherigen Trefferraum kollabieren zu lassen.
            var html = '';
            for (var i = 0; i < 3; i++) {
                html += '<li class="vsearch__skel-card">' +
                    '<div class="vsearch__skel-icon"></div>' +
                    '<div class="vsearch__skel-body">' +
                        '<div class="vsearch__skel-line vsearch__skel-line--title"></div>' +
                        '<div class="vsearch__skel-line vsearch__skel-line--meta"></div>' +
                        '<div class="vsearch__skel-line vsearch__skel-line--snippet"></div>' +
                        '<div class="vsearch__skel-line vsearch__skel-line--snippet2"></div>' +
                    '</div>' +
                '</li>';
            }
            resultsList.innerHTML = html;
        }

        function renderExtFilters(contentTypeFacets) {
            if (!extFiltersBox || !showFiletypeFilter) return;
            var visible = currentTypeFilter === '' || currentTypeFilter === 'file';
            // Counts pro Extension aus facets.content_type (Server liefert {pdf:3, docx:1, ...}).
            var counts = contentTypeFacets || {};
            // Nur Pills für Gruppen, deren Extensions mind. 1 Treffer haben.
            // Aktive Filter bleiben sichtbar auch wenn Count 0, sonst kann der User sie nicht mehr ausschalten.
            var available = FILETYPE_GROUPS.map(function (grp) {
                var sum = 0;
                grp.exts.forEach(function (e) { sum += (counts[e] || 0); });
                return {grp: grp, count: sum, active: currentExtGroups.indexOf(grp.key) !== -1};
            }).filter(function (x) { return x.count > 0 || x.active; });

            extFiltersBox.hidden = !visible || available.length === 0;
            if (extFiltersBox.hidden) { extFiltersBox.innerHTML = ''; return; }
            var html = '<span class="vsearch__sort-label" style="margin-right:.4rem;">Dateityp</span>';
            available.forEach(function (x) {
                var activeCls = x.active ? ' vsearch__ext-filter--active' : '';
                var countSuffix = x.count > 0 ? ' (' + x.count + ')' : '';
                html += '<button type="button" class="vsearch__ext-filter' + activeCls + '" data-vsearch-ext-group="' + escapeHtml(x.grp.key) + '">' + escapeHtml(x.grp.label) + countSuffix + '</button>';
            });
            extFiltersBox.innerHTML = html;
            Array.from(extFiltersBox.querySelectorAll('[data-vsearch-ext-group]')).forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var key = btn.dataset.vsearchExtGroup;
                    var idx = currentExtGroups.indexOf(key);
                    if (idx === -1) currentExtGroups.push(key);
                    else currentExtGroups.splice(idx, 1);
                    if (lastQuery) runSearch(lastQuery);
                });
            });
        }

        function render(data, q, append) {
            if (!append) resultsList.innerHTML = '';
            // Vorhandene „Mehr laden"-Buttons entfernen, neuer wird ggf. unten gesetzt
            var oldLoadMore = resultsList.parentNode.querySelector('.vsearch__loadmore');
            if (oldLoadMore) oldLoadMore.parentNode.removeChild(oldLoadMore);

            lastTagFacets = data.tagFacets || [];
            lastTotalHits = data.totalHits || 0;

            if (toolbar) toolbar.hidden = false;
            if (bodyBox) { bodyBox.hidden = false; bodyBox.classList.remove('vs-no-sidebar'); }
            meta.textContent = T('hits', { n: lastTotalHits, ms: (data.queryTimeMs || 0) });
            // Recent: erfolgreiche Query speichern (für Empty-State im Modal)
            if (!append && q && lastTotalHits > 0) pushRecent(q);

            // Cache-Strategie fuer Sidebar-Pills (Type & Tag):
            //  1) Ohne Filter cachen wir die VOLLE Type-Verteilung als Universal-Snapshot.
            //  2) Mit Tag-Filter aber ohne Type-Filter cachen wir die Type-Verteilung
            //     getrennt — diese „tag-gefilterten" Counts brauchen wir, wenn der
            //     User zusaetzlich einen Type-Filter setzt: andere Type-Pills muessen
            //     dann sichtbar bleiben, aber mit korrekten Counts zum aktiven Tag.
            //  3) Tag-Facets cachen wir ohne Type-Filter, damit bei Type-Filter-Klick
            //     der Tag-Bereich nicht verschwindet.
            if (data.facets && data.facets.type && currentTypeFilter === '') {
                if (currentTagFilters.length === 0) {
                    lastFullTypeFacets = data.facets.type;
                } else {
                    lastTagFilteredTypeFacets = data.facets.type;
                }
            }
            if (Array.isArray(data.tagFacets) && data.tagFacets.length && currentTypeFilter === '') {
                lastFullTagFacets = data.tagFacets;
            }
            // Render-Auswahl:
            // - Type-Pills: Tag aktiv → tag-gefilterter Snapshot, sonst Universal.
            // - Tag-Pills: voller Tag-Snapshot wenn vorhanden, sonst Live-Daten.
            var typeFacetsForSidebar;
            if (currentTagFilters.length > 0) {
                // Bei aktivem Type+Tag: cached tag-gefiltert (ohne type), sonst fresh.
                typeFacetsForSidebar = (currentTypeFilter !== '' && Object.keys(lastTagFilteredTypeFacets).length > 0)
                    ? lastTagFilteredTypeFacets
                    : (data.facets && data.facets.type ? data.facets.type : lastTagFilteredTypeFacets);
            } else {
                typeFacetsForSidebar = lastFullTypeFacets;
            }
            var tagFacetsForSidebar = lastFullTagFacets.length
                ? lastFullTagFacets
                : (Array.isArray(data.tagFacets) && data.tagFacets.length ? data.tagFacets : lastTagFacets);
            if (facetsBox) renderFacets(typeFacetsForSidebar, tagFacetsForSidebar, q);
            renderExtFilters((data.facets && data.facets.content_type) || {});

            if (!append && (!data.hits || data.hits.length === 0)) {
                resultsList.innerHTML = renderEmptyState(q, lastTagFacets);
                attachEmptyTipHandlers();
                return;
            }
            if (append && (!data.hits || data.hits.length === 0)) return;

            data.hits.forEach(function (hit) {
                var li = document.createElement('li');
                var a = document.createElement('a');
                a.href = hit.url || '#';
                if (hit.type === 'file' && hit.altText) a.title = hit.altText;
                else a.title = hit.url || '';
                if (openInNewTab) { a.target = '_blank'; a.rel = 'noopener noreferrer'; }
                a.addEventListener('click', function (e) {
                    if (openInNewTab) return;
                    if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
                    pushHashBeforeNavigate();
                });

                var ext = '';
                if (hit.type === 'file') {
                    var m = String(hit.url || '').match(/\.([a-z0-9]+)(?:[?#]|$)/i);
                    ext = m ? m[1].toLowerCase() : '';
                }
                var iconHtml = hit.type === 'file' ? iconFile(ext) : (hit.type === 'crawled' ? iconCrawled() : iconPage());
                var iconClass = 'vs-icon vs-icon--big';
                if (hit.type === 'file') iconClass += ' vs-icon--file vs-icon--' + (ext || 'generic');
                else if (hit.type === 'crawled') iconClass += ' vs-icon--crawled';
                else iconClass += ' vs-icon--page';

                // Cover ODER großes Icon-Placeholder
                var visualHtml;
                if (hit.coverUrl) {
                    var titleNoTags = (hit.title || '').replace(/<[^>]+>/g, '');
                    var coverAlt = hit.altText || titleNoTags || 'Vorschaubild';
                    // Bei Bildfehler: Cover-Container in Icon-Placeholder umwandeln statt entfernen
                    var fallbackHtml = encodeURIComponent('<span class="' + iconClass + '" data-fallback="1">' + iconHtml + '</span>');
                    visualHtml = '<span class="vs-icon vs-icon--cover">' +
                        '<img class="vs-cover-img" src="' + escapeHtml(hit.coverUrl) + '" alt="' + escapeHtml(coverAlt) + '" loading="lazy" ' +
                        'onerror="var p=this.parentNode;p.outerHTML=decodeURIComponent(\'' + fallbackHtml + '\');">' +
                    '</span>';
                } else {
                    visualHtml = '<span class="' + iconClass + '">' + iconHtml + '</span>';
                }
                /* iconClass enthält jetzt immer vs-icon--big damit das Placeholder
                   genauso groß wie ein Cover wirkt (120×120) — nie wieder Mini-Globus. */

                // Tags (kompakt, neben Titel)
                var tagsHtml = '';
                if (Array.isArray(hit.tagsResolved) && hit.tagsResolved.length) {
                    var chips = hit.tagsResolved.slice(0, 3).map(function (t) {
                        var boost = parseFloat(t.boost || 1.0);
                        var isBoosted = boost > 1.0 ? '1' : '0';
                        var pin = isBoosted === '1' ? '<svg class="vs-tag-pin" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 2l-1 1 2 2-5 5H4l5 5-5 5h6l5-5 2 2 1-1V2h-4z"/></svg>' : '';
                        var title = isBoosted === '1' ? ' title="Empfohlen — Tag mit erhöhter Relevanz (Boost ' + boost.toFixed(1) + ')"' : '';
                        return '<span class="vs-tag" data-color="' + escapeHtml(t.color || 'gray') + '" data-boost="' + isBoosted + '"' + title + '>' + pin + escapeHtml(t.label || t.slug || '') + '</span>';
                    });
                    tagsHtml = '<span class="vs-tags">' + chips.join('') + '</span>';
                }

                var lockBadge = hit.isProtected
                    ? '<span class="vs-lock" title="' + escapeHtml(T('lockedTitle')) + '" aria-label="' + escapeHtml(T('lockedAria')) + '">' + iconLock() + '</span>'
                    : '';

                // Meta-Zeile
                var typeKey;
                if (hit.type === 'file') typeKey = ext || 'file';
                else if (hit.type === 'crawled') typeKey = 'crawled';
                else typeKey = 'page';
                var typeLabel = TYPE_LABELS[typeKey] || typeKey.toUpperCase();
                var metaParts = ['<span class="vs-badge vs-badge--' + escapeHtml(typeKey) + '">' + escapeHtml(typeLabel) + '</span>'];
                if (hit.publishedAt && hit.publishedAt > 0 && !isCrawlDefaultDate(hit.publishedAt)) {
                    metaParts.push('<span class="vs-meta-dot">·</span><span class="vs-date">' + escapeHtml(formatDate(hit.publishedAt)) + '</span>');
                }
                if (hit.fileSize && hit.fileSize > 0) {
                    metaParts.push('<span class="vs-meta-dot">·</span><span class="vs-size">' + escapeHtml(formatBytes(hit.fileSize)) + '</span>');
                }
                metaParts.push('<span class="vs-meta-dot">·</span><span class="vs-url">' + escapeHtml(prettifyUrl(hit.url, hit.type)) + '</span>');
                var metaHtml = '<span class="vs-meta">' + metaParts.join('') + '</span>';

                var snippet = hit.snippet ? sanitizeWithMark(hit.snippet) : '';

                a.innerHTML =
                    visualHtml +
                    '<span class="vs-body">' +
                        '<span class="vs-title-row">' +
                            '<span class="vs-title">' + sanitizeWithMark(hit.title || '(ohne Titel)') + '</span>' +
                            lockBadge +
                            tagsHtml +
                        '</span>' +
                        metaHtml +
                        (snippet ? '<span class="vs-snippet">' + snippet + '</span>' : '') +
                    '</span>';
                li.appendChild(a);
                resultsList.appendChild(li);
            });

            // Offset hochzählen + Mehr-laden-Button wenn noch was übrig ist
            currentOffset += data.hits.length;
            if (currentOffset < lastTotalHits) {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'vsearch__loadmore';
                btn.textContent = T('loadMore', { n: (lastTotalHits - currentOffset) });
                btn.addEventListener('click', function () {
                    btn.disabled = true;
                    btn.textContent = T('loading');
                    runSearch(q, {append: true});
                });
                resultsList.parentNode.appendChild(btn);
            }
        }

        function renderEmptyState(q, tagFacets) {
            // Empty-State mit Tipps:
            //   - bei wenig Treffern Tag-Vorschläge anbieten (klickbar als Filter)
            //   - Recent-Searches als „Zuletzt gesucht"
            //   - immer einen Hinweis auf Tippfehler/andere Schreibweise
            var html =
                '<li class="vsearch__empty">' +
                    '<svg class="vsearch__empty-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">' +
                        '<circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>' +
                    '</svg>' +
                    '<p class="vsearch__empty-title">' + escapeHtml(T('noResults', { q: q })) + '</p>' +
                    '<p class="vsearch__empty-hint">' + escapeHtml(T('noResultsHint')) + '</p>';

            var recents = readRecent().filter(function (x) { return x.toLowerCase() !== q.toLowerCase(); });
            if (recents.length > 0) {
                html += '<div class="vsearch__empty-recent"><div class="vsearch__empty-recent-label">' + escapeHtml(T('recent')) + '</div><div class="vsearch__empty-tips">';
                recents.forEach(function (r) {
                    html += '<button type="button" class="vsearch__empty-tip" data-vsearch-recent="' + escapeHtml(r) + '">' + escapeHtml(r) + '</button>';
                });
                html += '</div></div>';
            }

            // Wenn Tags bekannt sind: top 6 anzeigen als „Vielleicht meinst du …"-Vorschläge
            if (Array.isArray(tagFacets) && tagFacets.length > 0) {
                var top = tagFacets.slice(0, 6);
                html += '<div class="vsearch__empty-recent"><div class="vsearch__empty-recent-label">' + escapeHtml(T('popularTags')) + '</div><div class="vsearch__empty-tips">';
                top.forEach(function (t) {
                    html += '<button type="button" class="vsearch__empty-tip" data-vsearch-empty-tag="' + escapeHtml(t.slug) + '">' +
                        escapeHtml(t.label) + '</button>';
                });
                html += '</div></div>';
            }
            html += '</li>';
            return html;
        }

        function showInitialState() {
            // Vor erster Query: zeige Welcome-Panel mit Recent Searches + populären Tags.
            // Tags werden lazy einmalig per leerem Search-Call geholt (siehe loadInitialTagFacets).
            var recents = readRecent();
            var tags = Array.isArray(initialTagFacets) ? initialTagFacets : [];
            var html = '<li class="vsearch__empty vsearch__empty-initial">' +
                '<svg class="vsearch__empty-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">' +
                    '<circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>' +
                '</svg>' +
                '<p class="vsearch__empty-title">' + escapeHtml(T('whatLookingFor')) + '</p>' +
                '<p class="vsearch__empty-hint">' + escapeHtml(T('initialHint')) + '</p>';
            // Reihenfolge: Tags zuerst (Discoverability) — dann erst „Zuletzt gesucht".
            if (tags.length > 0) {
                var topTags = tags.slice(0, 8);
                html += '<div class="vsearch__empty-recent"><div class="vsearch__empty-recent-label">' + escapeHtml(T('popularTags')) + '</div><div class="vsearch__empty-tips">';
                topTags.forEach(function (t) {
                    html += '<button type="button" class="vsearch__empty-tip vsearch__empty-tip--tag" data-color="' + escapeHtml(t.color || 'gray') + '" data-vsearch-empty-tag="' + escapeHtml(t.slug) + '">' +
                        escapeHtml(t.label) + '</button>';
                });
                html += '</div></div>';
            }
            if (recents.length > 0) {
                html += '<div class="vsearch__empty-recent"><div class="vsearch__empty-recent-label">' + escapeHtml(T('recent')) + '</div><div class="vsearch__empty-tips">';
                recents.forEach(function (r) {
                    html += '<button type="button" class="vsearch__empty-tip" data-vsearch-recent="' + escapeHtml(r) + '">' + escapeHtml(r) + '</button>';
                });
                html += '</div></div>';
            }
            html += '</li>';
            resultsList.innerHTML = html;
            attachEmptyTipHandlers();
            resultsBox.hidden = false;
            if (bodyBox) {
                bodyBox.hidden = false;
                bodyBox.classList.add('vs-no-sidebar');
            }
            if (toolbar) toolbar.hidden = true;
            // Lazy nachladen, falls Tags noch nicht vorliegen
            if (!Array.isArray(initialTagFacets) && !initialTagFacetsLoading) {
                loadInitialTagFacets();
            }
        }

        function loadInitialTagFacets() {
            initialTagFacetsLoading = true;
            // Leere Query liefert Top-Tags via facetDistribution — minimaler Payload (limit=0)
            var url = apiUrl + '?q=&locale=' + encodeURIComponent(locale) + '&limit=0';
            fetch(url, { headers: { 'Accept': 'application/json' } })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    initialTagFacets = Array.isArray(data.tagFacets) ? data.tagFacets : [];
                    initialTagFacetsLoading = false;
                    // Nur neu rendern, wenn das Initial-Panel noch sichtbar ist (User hat
                    // nicht zwischenzeitlich getippt). Erkennbar am .vsearch__empty-initial.
                    if (resultsList.querySelector('.vsearch__empty-initial')) {
                        showInitialState();
                    }
                })
                .catch(function () {
                    initialTagFacetsLoading = false;
                });
        }

        function syncSortPills(sort) {
            if (!sortPillsBox) return;
            sortPillsBox.querySelectorAll('[data-sort]').forEach(function (b) {
                var active = b.dataset.sort === sort;
                b.classList.toggle('vsearch__sort-pill--active', active);
                b.setAttribute('aria-pressed', active ? 'true' : 'false');
            });
        }

        function attachEmptyTipHandlers() {
            Array.from(resultsList.querySelectorAll('[data-vsearch-empty-tag]')).forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var slug = btn.dataset.vsearchEmptyTag;
                    if (currentTagFilters.indexOf(slug) === -1) currentTagFilters.push(slug);
                    input.value = '';
                    lastQuery = '';
                    toggleClearBtn();
                    // Tag-only-Browse: ohne Volltext-Query gibt es keinen Score,
                    // also direkt chronologisch sortieren (Neueste oben). User
                    // kann das per Sort-Pill bei Bedarf umschalten.
                    currentSort = 'date_desc';
                    if (sortSelect) sortSelect.value = 'date_desc';
                    syncSortPills('date_desc');
                    runSearch('');
                });
            });
            Array.from(resultsList.querySelectorAll('[data-vsearch-recent]')).forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var q = btn.dataset.vsearchRecent;
                    input.value = q;
                    lastQuery = q;
                    toggleClearBtn();
                    runSearch(q);
                });
            });
        }

        function iconLock() {
            return '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
                '<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>' +
                '<path d="M7 11V7a5 5 0 0 1 10 0v4"/>' +
            '</svg>';
        }

        function renderFacets(typeFacets, tagFacets, q) {
            typeFacets = typeFacets || {};
            var labels = { page: T('typePages'), file: T('typeFiles'), article: T('typeArticles'), crawled: T('typeCrawledPl') };
            var html = '<button type="button" class="vsearch__facet' + (currentTypeFilter === '' ? ' vsearch__facet--active' : '') + '" data-vsearch-facet-type="">' + escapeHtml(T('all')) + '</button>';
            Object.keys(typeFacets).forEach(function (type) {
                var active = currentTypeFilter === type ? ' vsearch__facet--active' : '';
                var label = labels[type] || type;
                html += '<button type="button" class="vsearch__facet' + active + '" data-vsearch-facet-type="' + escapeHtml(type) + '">' + escapeHtml(label) + ' (' + typeFacets[type] + ')</button>';
            });
            facetsBox.innerHTML = html;
            Array.from(facetsBox.querySelectorAll('[data-vsearch-facet-type]')).forEach(function (btn) {
                btn.addEventListener('click', function () {
                    currentTypeFilter = btn.dataset.vsearchFacetType;
                    if (currentTypeFilter !== '' && currentTypeFilter !== 'file') currentExtGroups = [];
                    runSearch(q);
                });
            });

            // Tags eigenständig in Sidebar-Bereich rendern (wenn vorhanden).
            var tagCloud = box.querySelector('[data-vsearch-tag-cloud]');
            var tagSection = box.querySelector('[data-vsearch-sidebar-tags]');
            if (tagCloud && tagSection) {
                if (Array.isArray(tagFacets) && tagFacets.length) {
                    var tagHtml = '';
                    tagFacets.forEach(function (t) {
                        var active = currentTagFilters.indexOf(t.slug) !== -1 ? ' vsearch__facet--tag-active' : '';
                        tagHtml += '<button type="button" class="vsearch__facet vsearch__facet--tag' + active + '" data-color="' + escapeHtml(t.color || 'gray') + '" data-vsearch-facet-tag="' + escapeHtml(t.slug) + '">'
                             + escapeHtml(t.label) + ' (' + t.count + ')</button>';
                    });
                    tagCloud.innerHTML = tagHtml;
                    tagSection.hidden = false;
                    Array.from(tagCloud.querySelectorAll('[data-vsearch-facet-tag]')).forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            var slug = btn.dataset.vsearchFacetTag;
                            var idx = currentTagFilters.indexOf(slug);
                            if (idx === -1) currentTagFilters.push(slug);
                            else currentTagFilters.splice(idx, 1);
                            // Wenn jetzt keine Volltext-Query mehr aktiv ist, auf
                            // chronologisch umstellen — ohne Score wuerde Meilisearch
                            // sonst eine willkuerliche Reihenfolge liefern.
                            if (!q || q.trim() === '') {
                                currentSort = 'date_desc';
                                if (sortSelect) sortSelect.value = 'date_desc';
                                syncSortPills('date_desc');
                            }
                            runSearch(q);
                        });
                    });
                } else {
                    tagCloud.innerHTML = '';
                    tagSection.hidden = true;
                }
            }
        }

        function escapeHtml(s) {
            return String(s).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }
        function sanitizeWithMark(s) {
            return escapeHtml(s).replace(/&lt;mark&gt;/g, '<mark>').replace(/&lt;\/mark&gt;/g, '</mark>');
        }
        function prettifyUrl(url, type) {
            if (!url) return '';
            try { url = decodeURI(url); } catch (e) {}
            if (type === 'file') {
                var idx = url.lastIndexOf('/');
                return idx >= 0 ? url.substring(idx + 1) : url;
            }
            return url === '/' ? 'Startseite' : url;
        }
        function formatBytes(bytes) {
            if (!bytes || bytes < 1024) return (bytes || 0) + ' B';
            var units = ['KB', 'MB', 'GB'];
            var i = -1; var n = bytes;
            do { n /= 1024; i++; } while (n >= 1024 && i < units.length - 1);
            return n.toFixed(n < 10 ? 1 : 0) + ' ' + units[i];
        }
        function formatDate(ts) {
            var d = new Date(ts * 1000);
            if (isNaN(d.getTime())) return '';
            var dd = String(d.getDate()).padStart(2, '0');
            var mm = String(d.getMonth() + 1).padStart(2, '0');
            return dd + '.' + mm + '.' + d.getFullYear();
        }
        // Crawler-Default-Datum: bei Crawler-Hits ohne erkennbares Inhaltsdatum
        // wird der Indexier-Zeitpunkt eingetragen (typisch 31.12. eines Jahres,
        // Mitternacht UTC). Diese Daten sind keine echten Veroeffentlichungs-
        // daten und sollten in der UI weder angezeigt noch fuer Sort genutzt
        // werden. Heuristik: 31.12. eines beliebigen Jahres, exakt Mitternacht UTC.
        function isCrawlDefaultDate(ts) {
            if (!ts || ts <= 0) return true;
            var d = new Date(ts * 1000);
            if (isNaN(d.getTime())) return true;
            return d.getUTCMonth() === 11 && d.getUTCDate() === 31
                && d.getUTCHours() === 0 && d.getUTCMinutes() === 0 && d.getUTCSeconds() === 0;
        }
        function iconFile(ext) {
            var label = (ext || 'FILE').toUpperCase().substring(0, 4);
            var fontSize = label.length > 3 ? 4.6 : 5.5;
            return '<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
                '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>' +
                '<polyline points="14 2 14 8 20 8"/>' +
                '<text x="12" y="17" text-anchor="middle" stroke="none" fill="currentColor" font-size="' + fontSize + '" font-weight="700" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif" letter-spacing="0.3">' + label + '</text>' +
            '</svg>';
        }
        function iconCrawled() {
            // Globus-Icon für externe Webseiten-Inhalte
            return '<svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
                '<circle cx="12" cy="12" r="9"/>' +
                '<path d="M3 12h18M12 3a14 14 0 0 1 4 9 14 14 0 0 1-4 9 14 14 0 0 1-4-9 14 14 0 0 1 4-9z"/>' +
            '</svg>';
        }
        function iconPage() {
            return '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
                '<circle cx="12" cy="12" r="9"/>' +
                '<line x1="3" y1="12" x2="21" y2="12"/>' +
                '<path d="M12 3a14 14 0 0 1 4 9 14 14 0 0 1-4 9 14 14 0 0 1-4-9 14 14 0 0 1 4-9z"/>' +
            '</svg>';
        }

        // popstate
        window.addEventListener('popstate', function () {
            var state = parseState(window.location.hash);
            var modalShell = (mode === 'modal') ? box.querySelector('[data-vsearch-shell]') : null;
            if (state && state.q) {
                if (modalShell && modalShell.hidden) {
                    modalShell.hidden = false;
                    document.body.style.overflow = 'hidden';
                }
                restoreFromHash();
            } else if (modalShell && !modalShell.hidden && typeof closeModal === 'function') {
                closeModal();
            } else if (mode !== 'modal') {
                input.value = ''; lastQuery = '';
                resultsBox.hidden = true;
                if (toolbar) toolbar.hidden = true;
                if (bodyBox) bodyBox.hidden = true;
                currentTypeFilter = ''; currentTagFilters = [];
                currentSort = 'relevance'; currentExtGroups = [];
                if (sortSelect) sortSelect.value = 'relevance';
                syncSortPills('relevance');
                toggleClearBtn();
            }
        });

        // Initial-Restore
        (function initFromHash() {
            var initialState = parseState(window.location.hash);
            if (!initialState || !initialState.q) return;
            if (mode === 'modal') {
                var modalShell = box.querySelector('[data-vsearch-shell]');
                if (modalShell) { modalShell.hidden = false; document.body.style.overflow = 'hidden'; }
            }
            restoreFromHash();
        })();

        // === Recent Searches (localStorage, pro Modul-ID) ===
        function readRecent() {
            try {
                var raw = window.localStorage.getItem(RECENT_KEY);
                if (!raw) return [];
                var arr = JSON.parse(raw);
                return Array.isArray(arr) ? arr.slice(0, RECENT_MAX) : [];
            } catch (e) { return []; }
        }
        function pushRecent(q) {
            try {
                var list = readRecent().filter(function (x) { return x.toLowerCase() !== q.toLowerCase(); });
                list.unshift(q);
                window.localStorage.setItem(RECENT_KEY, JSON.stringify(list.slice(0, RECENT_MAX)));
            } catch (e) {}
        }
        function clearRecent() {
            try { window.localStorage.removeItem(RECENT_KEY); } catch (e) {}
        }

        // === Tastatur-Navigation in Trefferliste (↑/↓/Enter) ===
        var keyboardCursor = -1;
        function moveCursor(delta) {
            var items = Array.from(resultsList.querySelectorAll('li > a'));
            if (!items.length) return;
            items.forEach(function (a) { a.parentNode.classList.remove('vs-active'); });
            keyboardCursor = Math.max(0, Math.min(items.length - 1, keyboardCursor + delta));
            var target = items[keyboardCursor];
            if (target) {
                target.parentNode.classList.add('vs-active');
                target.parentNode.scrollIntoView({block: 'nearest', behavior: 'smooth'});
            }
        }
        input.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowDown') { e.preventDefault(); moveCursor(+1); }
            else if (e.key === 'ArrowUp') { e.preventDefault(); moveCursor(-1); }
            else if (e.key === 'Enter' && keyboardCursor >= 0) {
                var items = Array.from(resultsList.querySelectorAll('li > a'));
                if (items[keyboardCursor]) {
                    e.preventDefault();
                    items[keyboardCursor].click();
                }
            }
        });

        toggleClearBtn();
    });
})();
</script>
